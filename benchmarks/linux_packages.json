{
  "description": "Ubuntu apt packages used for BASICS Linux binary sweeps. The setup script downloads packages from the configured apt repositories, extracts executable ELF files, and records package versions in the generated manifest.",
  "output_manifest": "Benchmarks/linux_repos/linux_repo_binary_cases.json",
  "max_binaries_per_package": 20,
  "max_binary_size_mb": 25,
  "groups": {
    "core": [
      "bash",
      "coreutils",
      "findutils",
      "grep",
      "sed",
      "gawk",
      "tar",
      "gzip",
      "bzip2",
      "xz-utils",
      "util-linux",
      "procps",
      "iproute2",
      "iputils-ping",
      "curl",
      "wget",
      "openssh-client",
      "rsync",
      "sqlite3",
      "jq",
      "git"
    ],
    "additional": [
      "net-tools",
      "dnsutils",
      "whois",
      "file",
      "less",
      "zip",
      "unzip",
      "cpio",
      "p7zip-full",
      "lhasa",
      "arj",
      "unrar-free",
      "poppler-utils",
      "mupdf-tools",
      "libtiff-tools",
      "webp",
      "gifsicle",
      "jpegoptim",
      "optipng",
      "pngcrush",
      "libimage-exiftool-perl",
      "xmlstarlet",
      "tidy",
      "html-xml-utils",
      "sox",
      "flac",
      "vorbis-tools",
      "opus-tools",
      "wavpack",
      "ffmpeg",
      "tcpdump",
      "socat",
      "iperf3",
      "nghttp2-client",
      "mosquitto-clients",
      "openssl",
      "gnutls-bin"
    ]
  },
  "all_function_scan": {
    "workers": 4,
    "timeout_sec": 600,
    "scan_memory_limit_mb": 3000,
    "hard_memory_limit_mb": null,
    "concolic_step_limit": 100,
    "scan_arg_stack_guard_bytes": "0x200000",
    "scan_constrain_arg_regs": false,
    "scan_include_runtime_symbols": false,
    "scan_confirm_callers": true,
    "scan_confirm_max_callers": 4,
    "scan_skip_loopfinder": false
  }
}
